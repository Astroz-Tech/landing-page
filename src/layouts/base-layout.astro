---
import { Font } from "astro:assets";
import { ArrowUp } from "@lucide/astro";
import "../styles/global.css";
import SiteHeader from "../components/organisms/site-header.astro";
import SiteFooter from "../components/organisms/site-footer.astro";
import { site } from "../lib/site";
import type { JsonLd } from "../lib/json-ld";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  jsonLd?: JsonLd;
}

const { title, description, ogImage = "/opengraph-image.png", type = "website", jsonLd } =
  Astro.props;
const siteUrl = Astro.site;
if (!siteUrl) throw new Error("Set `site` in astro.config.mjs");

const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <Font cssVariable="--font-jakarta-sans" preload />
    <Font cssVariable="--font-geist-mono" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.style.colorScheme = dark ? "dark" : "light";
      })();
    </script>
    <script is:inline>
      document.documentElement.dataset.scrollTop = "js";
    </script>
    <script is:inline>
      /*
       * Back to top. Visible once the hero has scrolled away, hidden again at
       * the top. Passive listener, no layout reads on every frame.
       */
      (() => {
        const start = () => {
          const button = document.querySelector(".back-to-top");
          if (!button) return;

          let ticking = false;
          const update = () => {
            ticking = false;
            button.classList.toggle("is-visible", window.scrollY > window.innerHeight * 0.75);
          };

          window.addEventListener(
            "scroll",
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(update);
            },
            { passive: true },
          );
          update();
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start, { once: true });
        } else {
          start();
        }
      })();
    </script>
    <script is:inline>
      /*
       * Scroll reveal. Runs before paint, so nothing flashes visible and then
       * jumps to hidden.
       *
       * Each element animates once, the first time it enters the viewport, and
       * is then unobserved: scrolling back up does not replay it.
       *
       * Elements already in the viewport when the page opens are the page's
       * entrance: they are given an increasing --reveal-delay so the first
       * screen performs a visible top-to-bottom cascade instead of appearing
       * all at once. Everything below the fold animates as it is scrolled in.
       *
       * The hidden state is scoped to html[data-reveal="js"], which this script
       * sets, so if it never runs (no JS, reduced motion, no observer) nothing
       * is hidden.
       */
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!("IntersectionObserver" in window)) return;

        document.documentElement.dataset.reveal = "js";

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
        );

        const start = () => {
          const elements = [...document.querySelectorAll(".reveal")];
          const viewport = window.innerHeight;
          let seen = 0;

          for (const el of elements) {
            const box = el.getBoundingClientRect();
            if (box.top < viewport * 0.9 && box.bottom > 0) {
              el.style.setProperty("--reveal-delay", `${120 + Math.min(seen, 5) * 90}ms`);
              seen += 1;
            }

            observer.observe(el);
          }
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start, { once: true });
        } else {
          start();
        }
      })();
    </script>
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body
    id="top"
    class="isolate flex min-h-screen flex-col bg-background font-sans text-foreground antialiased"
  >
    <div class="canvas-frame" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:inline-flex focus:min-h-11 focus:items-center focus:px-4 focus:ring-2 focus:ring-ring"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="flex-1"><slot /></main>
    <SiteFooter />
    <a
      href="#top"
      aria-label="Back to top"
      class="back-to-top fixed bottom-6 right-6 z-40 inline-flex size-11 items-center justify-center rounded-lg border border-border bg-background/90 text-muted-foreground backdrop-blur hover:border-primary/40 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 print:hidden"
    >
      <ArrowUp size={16} stroke-width={1.5} aria-hidden="true" />
    </a>
  </body>
</html>
