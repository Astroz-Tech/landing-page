---
import BaseLayout from "../../../layouts/base-layout.astro";
import ProjectCard from "../../../components/molecules/project-card.astro";
import { getProjects } from "../../../lib/projects";
import { isLang, locales, useTranslations, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error(`Unknown locale: ${langParam}`);
const lang: Lang = langParam;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout
  lang={lang}
  title={t("meta.projects.title")}
  description={t("meta.projects.description")}
  ogImage={`/og/projects/${lang}.png`}
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24">
    <h1
      class="reveal font-semibold text-[clamp(2.5rem,5vw,4rem)] leading-[1.05] tracking-[-0.03em]"
    >
      {t("projects.title")}
    </h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted-foreground text-pretty">
      {t("projects.intro")}
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        projects.map((entry, index) => (
          <div class:list={["reveal", index > 3 ? "reveal-3" : index > 1 ? "reveal-2" : ""]}>
            <ProjectCard entry={entry} lang={lang} heading="h2" />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
