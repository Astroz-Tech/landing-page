---
import { Mail } from "@lucide/astro";
import { badgeVariants } from "$lib/components/ui/badge/index";
import { buttonVariants } from "$lib/components/ui/button/index";
import BaseLayout from "../../layouts/base-layout.astro";
import SectionHeader from "../../components/molecules/section-header.astro";
import { site } from "../../lib/site";
import { isLang, locales, useTranslations, type Lang } from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error(`Unknown locale: ${langParam}`);
const lang: Lang = langParam;
const t = useTranslations(lang);
const siteUrl = Astro.site;
if (!siteUrl) throw new Error("Set `site` in astro.config.mjs");

const tags = [
  t("home.tags.everyone"),
  t("home.tags.open"),
  t("home.tags.community"),
  t("home.tags.learn"),
];

const pillars = [
  t("home.pillars.everyone"),
  t("home.pillars.open"),
  t("home.pillars.community"),
  t("home.pillars.learn"),
  t("home.pillars.experiment"),
  t("home.pillars.transparency"),
  t("home.pillars.collaboration"),
];

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  description: site.description,
  url: siteUrl.href,
  sameAs: Object.values(site.social),
};
---

<BaseLayout
  lang={lang}
  title={t("meta.home.title")}
  description={t("meta.home.description")}
  ogImage={`/og/home/${lang}.png`}
  jsonLd={organization}
>
  <section class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h1
          class="reveal font-semibold text-[clamp(3rem,7vw,5.5rem)] leading-[1.02] tracking-[-0.035em] text-balance"
        >
          {t("home.hero.title")}
        </h1>
        <p class="reveal mt-6 max-w-[48ch] text-lg leading-[1.65] text-muted-foreground text-pretty">
          {t("home.hero.lead")}
        </p>
        <ul class="reveal mt-8 flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <li class="inline-flex min-h-11 items-center rounded-md border border-border px-3 py-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground">
                {tag}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal lg:justify-self-end">
        <img
          src="/hero.png"
          width="736"
          height="736"
          alt={t("home.hero.imageAlt")}
          loading="eager"
          decoding="async"
          class="w-full max-w-md rounded-lg border border-border lg:max-w-none"
        />
      </div>
    </div>
  </section>

  <section class="border-y border-border">
    <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
      <h2
        class="reveal font-semibold text-[clamp(2rem,3.5vw,3rem)] leading-[1.1] tracking-[-0.025em]"
      >
        {t("home.mission.title")}
      </h2>
      <p class="reveal reveal-2 mt-6 max-w-[65ch] text-muted-foreground text-pretty">
        {t("home.mission.body")}
      </p>
      <p class="reveal reveal-2 mt-4 max-w-[65ch] text-muted-foreground text-pretty">
        {t("home.mission.body2")}
      </p>
      <blockquote class="reveal reveal-3 mt-10 border-l-2 border-primary pl-5">
        <p class="text-2xl font-medium leading-snug">{t("home.mission.quote")}</p>
        <p class="mt-4 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground">
          — {t("home.mission.quoteBy")}
        </p>
      </blockquote>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
    <div class="reveal">
      <SectionHeader
        lang={lang}
        eyebrow={t("brand.name")}
        title={t("home.pillars.title")}
        intro={t("home.pillars.intro")}
      />
    </div>
    <ul class="flex flex-wrap gap-2">
      {
        pillars.map((pillar, index) => (
          <li class:list={["reveal", index > 4 ? "reveal-3" : index > 2 ? "reveal-2" : ""]}>
            <span
              class={badgeVariants({ variant: "secondary" }) +
                " font-mono text-[0.625rem] uppercase tracking-[0.12em]"}
            >
              {pillar}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24 md:px-8 md:pb-32">
    <div
      class="reveal flex flex-col items-center rounded-lg border border-border bg-card p-10 text-center md:p-16"
    >
      <h2
        class="max-w-[30ch] font-semibold text-[clamp(1.5rem,3.5vw,2.25rem)] leading-[1.15] tracking-[-0.025em] text-balance"
      >
        {t("home.cta.title")}
      </h2>
      <a
        href={`mailto:${site.email}`}
        class={buttonVariants({
          size: "lg",
          class: "reveal reveal-2 mt-8 font-semibold duration-200 hover:-translate-y-0.5",
        })}
      >
        <Mail size={16} stroke-width={1.5} aria-hidden="true" />
        {t("home.cta.action")}
      </a>
    </div>
  </section>
</BaseLayout>
