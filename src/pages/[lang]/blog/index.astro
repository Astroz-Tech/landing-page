---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../../../layouts/base-layout.astro";
import BlogRow from "../../../components/molecules/blog-row.astro";
import { getBlogPosts } from "../../../lib/blog";
import { isLang, locales, useTranslations, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) throw new Error(`Unknown locale: ${langParam}`);
const lang: Lang = langParam;
const t = useTranslations(lang);
const posts = await getBlogPosts(lang);
---

<BaseLayout
  lang={lang}
  title={t("meta.blog.title")}
  description={t("meta.blog.description")}
  ogImage={`/og/blog/${lang}.png`}
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24">
    <p class="reveal font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-primary">
      {t("brand.name")}
    </p>
    <h1
      class="reveal mt-3 font-semibold text-[clamp(2.5rem,5vw,4rem)] leading-[1.05] tracking-[-0.03em]"
    >
      {t("blog.title")}
    </h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted-foreground text-pretty">
      {t("blog.intro")}
    </p>

    <div class="mt-8">
      {
        posts.map((entry, index) => (
          <div class:list={["reveal", index > 3 ? "reveal-3" : index > 1 ? "reveal-2" : ""]}>
            <BlogRow entry={entry} lang={lang} heading="h2" />
          </div>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <div class="reveal mt-10 rounded-lg border border-dashed border-border p-10">
          <h2 class="font-semibold text-2xl">{t("blog.empty.title")}</h2>
          <p class="mt-3 max-w-xl text-muted-foreground">{t("blog.empty.body")}</p>
          <a
            href={getRelativeLocaleUrl(lang)}
            class="mt-6 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4"
          >
            {t("blog.empty.action")}
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>
