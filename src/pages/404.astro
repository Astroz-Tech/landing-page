---
import BaseLayout from "../layouts/base-layout.astro";
import { buttonVariants } from "$lib/components/ui/button/index";
---

<BaseLayout
  title="Page not found | Astroz"
  description="The page you requested does not exist."
>
  <section class="mx-auto max-w-6xl px-6 py-24 md:px-8">
    <p class="reveal font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-primary">404</p>
    <h1
      class="reveal mt-4 font-semibold text-[clamp(2.5rem,5vw,4rem)] leading-[1.05] tracking-[-0.03em]"
    >
      This page is not here.
    </h1>
    <p class="reveal mt-4 max-w-xl text-muted-foreground">
      The link may be out of date, or the page may have moved. Start from the home page or read
      the blog.
    </p>
    <a
      href="/"
      class={buttonVariants({
        size: "lg",
        class: "reveal mt-8 font-semibold duration-200 hover:-translate-y-0.5 active:translate-y-0",
      })}
    >
      Go home
    </a>
  </section>
</BaseLayout>
