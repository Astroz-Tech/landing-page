---
import BaseLayout from "../../layouts/base-layout.astro";
import BlogRow from "../../components/molecules/blog-row.astro";
import { getBlogPosts } from "../../lib/blog";

const posts = await getBlogPosts();
---

<BaseLayout
  title="Blog | Astroz"
  description="Notes from Astroz workshops, builds, and open source work."
  ogImage="/og/blog.png"
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24">
    <h1
      class="reveal font-semibold text-[clamp(2.5rem,5vw,4rem)] leading-[1.05] tracking-[-0.03em]"
    >
      OUR BLOG
    </h1>
    <p class="reveal mt-4 max-w-2xl text-lg text-muted-foreground text-pretty">
      Workshop notes, build logs, and the reasoning behind decisions on this site.
    </p>

    <div class="mt-8">
      {
        posts.map((entry, index) => (
          <div class:list={["reveal", index > 3 ? "reveal-3" : index > 1 ? "reveal-2" : ""]}>
            <BlogRow entry={entry} heading="h2" />
          </div>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <div class="reveal mt-10 rounded-lg border border-dashed border-border p-10">
          <h2 class="font-semibold text-2xl">The first dispatch is being written.</h2>
          <p class="mt-3 max-w-xl text-muted-foreground">
            No notes are published yet. The first write-up lands after the next session.
          </p>
          <a
            href="/"
            class="mt-6 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 transition-[color,translate,text-decoration-color] duration-200 hover:-translate-y-0.5 hover:decoration-primary"
          >
            Back to home
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>
