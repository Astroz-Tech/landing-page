---
import { buttonVariants } from "$lib/components/ui/button/index";
import ThemeToggle from "../molecules/theme-toggle.svelte";
import MobileNav from "./mobile-nav.svelte";
import { site } from "../../lib/site";
import { normalizePath } from "../../lib/utils";

const home = "/";
const nav = [
  { href: home, label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/projects", label: "Projects" },
];
const isActive = (href: string) => {
  const path = normalizePath(Astro.url.pathname);
  const target = normalizePath(href);
  return target === normalizePath(home)
    ? path === target
    : path === target || path.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6 md:grid md:grid-cols-[1fr_auto_1fr] md:px-8"
  >
    <a
      href={home}
      class="inline-flex min-h-11 w-fit items-center transition-opacity duration-200 hover:opacity-70"
    >
      <img
        src="/assets/logo-navy.png"
        alt="Astroz"
        width={644}
        height={400}
        class="h-8 w-auto dark:hidden"
      />
      <img
        src="/assets/logo-white.png"
        alt="Astroz"
        width={602}
        height={374}
        class="hidden h-8 w-auto dark:block"
      />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Menu">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "link-underline inline-flex min-h-11 items-center text-sm transition-colors duration-200 hover:text-foreground",
              isActive(item.href) ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 md:justify-self-end md:gap-2">
      <ThemeToggle client:load label="Toggle light and dark theme" />
      <a
        href={`mailto:${site.email}`}
        class={buttonVariants({
          size: "lg",
          class:
            "hidden font-semibold duration-200 hover:-translate-y-0.5 active:translate-y-0 md:inline-flex",
        })}
      >
        Donate
      </a>
      <MobileNav
        client:load
        items={nav}
        contactHref={`mailto:${site.email}`}
        contactLabel="Donate"
        menuLabel="Open menu"
        title="Menu"
        description="Menu"
        closeLabel="Close menu"
      />
    </div>
  </div>
</header>
