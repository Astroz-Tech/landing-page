---
import { getRelativeLocaleUrl } from "astro:i18n";
import { buttonVariants } from "$lib/components/ui/button/index";
import ThemeToggle from "../molecules/theme-toggle.svelte";
import MobileNav from "./mobile-nav.svelte";
import { site } from "../../lib/site";
import { getLocaleSwitchHref } from "../../lib/i18n-links";
import { normalizePath } from "../../lib/utils";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "en" ? "id" : "en";
const switchHref = getLocaleSwitchHref(Astro.url.pathname, other);
const home = getRelativeLocaleUrl(lang);
const nav = [
  { href: home, label: t("nav.home") },
  { href: getRelativeLocaleUrl(lang, "blog"), label: t("nav.blog") },
  { href: getRelativeLocaleUrl(lang, "projects"), label: t("nav.projects") },
];
const isActive = (href: string) => {
  const path = normalizePath(Astro.url.pathname);
  const target = normalizePath(href);
  return target === normalizePath(home)
    ? path === target
    : path === target || path.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6 md:grid md:grid-cols-[1fr_auto_1fr] md:px-8"
  >
    <a
      href={home}
      class="inline-flex min-h-11 items-center transition-opacity duration-200 hover:opacity-70"
    >
      <span class="font-semibold text-xl tracking-tight">{t("brand.name")}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label={t("nav.menu")}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "link-underline inline-flex min-h-11 items-center text-sm transition-colors duration-200 hover:text-foreground",
              isActive(item.href) ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 md:justify-self-end md:gap-2">
      <a
        href={switchHref}
        hreflang={other}
        lang={other}
        aria-label={t("a11y.switchTo").replace("{language}", t(`language.${other}`))}
        class="inline-flex h-11 min-w-11 items-center justify-center rounded-md px-2 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground transition-colors duration-200 hover:bg-accent hover:text-foreground"
      >
        {other.toUpperCase()}
      </a>
      <ThemeToggle client:load label={t("a11y.themeToggle")} />
      <a
        href={`mailto:${site.email}`}
        class={buttonVariants({ size: "lg", class: "hidden font-semibold duration-200 hover:-translate-y-0.5 md:inline-flex" })}
      >
        {t("nav.donate")}
      </a>
      <MobileNav
        client:load
        items={nav}
        contactHref={`mailto:${site.email}`}
        contactLabel={t("nav.donate")}
        menuLabel={t("a11y.openMenu")}
        title={t("nav.menu")}
        description={t("nav.menu")}
        closeLabel={t("a11y.closeMenu")}
      />
    </div>
  </div>
</header>
