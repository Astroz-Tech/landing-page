---
import { getRelativeLocaleUrl } from "astro:i18n";
import SocialIcon from "../atoms/social-icon.astro";
import { site } from "../../lib/site";
import { useTranslations, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const social = [
  { name: "x", href: site.social.x, label: "X" },
  { name: "github", href: site.social.github, label: "GitHub" },
  { name: "instagram", href: site.social.instagram, label: "Instagram" },
  { name: "linkedin", href: site.social.linkedin, label: "LinkedIn" },
] as const;
---

<footer class="border-t border-border bg-background">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between md:px-8"
  >
    <div>
      <a
        href={getRelativeLocaleUrl(lang)}
        class="inline-flex min-h-11 items-center font-semibold text-xl tracking-tight"
      >
        {t("brand.name")}
      </a>
      <p class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">
        {t("footer.rights").replace("{year}", String(year))}
      </p>
    </div>
    <ul class="flex items-center gap-1">
      {
        social.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
              class="group inline-flex h-11 w-11 items-center justify-center rounded-md text-muted-foreground transition-[background-color,color,translate] duration-200 hover:-translate-y-0.5 hover:bg-accent hover:text-foreground"
            >
              <span class="transition-[scale] duration-200 group-hover:scale-110">
                <SocialIcon name={item.name} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
