---
import { ArrowUpRight } from "@lucide/astro";
import { cn } from "$lib/utils";
import type { ProjectEntry } from "../../lib/projects";

interface Props {
  entry: ProjectEntry;
  heading?: "h2" | "h3";
}

const { entry, heading = "h3" } = Astro.props;
const Heading = heading;
const href = entry.data.url;
const Tag = href ? "a" : "article";
---

<Tag
  {...(href ? { href, target: "_blank", rel: "noopener noreferrer" } : {})}
  class={cn(
    "group flex flex-col rounded-lg border border-border bg-card p-5 transition-[translate,border-color,background-color] duration-200 md:p-6",
    href && "hover:-translate-y-0.5 hover:border-primary/40 hover:bg-accent/30",
  )}
>
  <span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground">
    {entry.data.year}
  </span>
  <Heading class="mt-4 font-semibold text-2xl leading-tight tracking-[-0.01em] md:text-3xl">
    {entry.data.title}
  </Heading>
  <p class="mb-6 mt-3 text-sm text-muted-foreground text-pretty">{entry.data.summary}</p>
  <div class="mt-auto flex items-center justify-between border-t border-border pt-4 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted-foreground">
    <span>VISIT PROJECT</span>
    {
      href && (
        <span class="inline-flex items-center gap-1 text-primary">
          <ArrowUpRight
            size={16}
            stroke-width={1.5}
            aria-hidden="true"
            class="transition-[translate] duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
          />
          <span class="sr-only">(opens in a new tab)</span>
        </span>
      )
    }
  </div>
</Tag>
