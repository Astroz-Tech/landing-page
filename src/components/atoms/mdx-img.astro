---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"img"> {
  src?: string;
  alt?: string;
}

const { src = "", alt = "", ...props } = Astro.props;
---

<img
  src={src}
  alt={alt}
  loading="lazy"
  decoding="async"
  class="rounded-lg border border-border"
  {...props}
/>
