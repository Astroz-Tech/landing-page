{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "$lib": ["./src"],
      "$lib/*": ["./src/*"],
      "$lib/utils": ["./src/lib/utils"],
      "$lib/utils.js": ["./src/lib/utils.ts"],
      "$lib/hooks": ["./src/lib/hooks"],
      "$lib/hooks/*": ["./src/lib/hooks/*"]
    }
  }
}
